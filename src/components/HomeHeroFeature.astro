---
import NameSeal from './NameSeal.astro'
import { homeHeroArtwork } from '../data/home-artwork'
import { withBase } from '../utils/paths'
import ActionLink from './ActionLink.astro'
---

<section class="hero-feature" aria-labelledby="hero-title">
  <img class="hero-artwork" src={homeHeroArtwork.src} alt={homeHeroArtwork.alt} style={`object-position: ${homeHeroArtwork.position};`} width="1200" height="400" fetchpriority="high" decoding="async" />
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-content">
    <p class="hero-eyebrow"><span data-home-greeting>展卷有时</span><span class="hero-dot">·</span>赵佶的宋代手札</p>
    <h1 id="hero-title">朕的御花园</h1>
    <p class="hero-subtitle">翰墨丹青，四时清趣。<br />于笔墨间，寄一方天地。</p>
    <div class="hero-actions">
      <ActionLink href={withBase('/posts/')}>翻阅手札 <span aria-hidden="true">→</span></ActionLink>
      <ActionLink variant="text" href="#gallery">赏四时 <span aria-hidden="true">↗</span></ActionLink>
    </div>
  </div>
  <div class="hero-inscription" aria-hidden="true"><span>{homeHeroArtwork.title}</span><NameSeal text="宣和" /></div>
  <span class="hero-caption">书画 · 园林 · 案头闲情</span>
</section>

<script>
  import { greetingForHour } from '../utils/greeting.js'
  function updateGreeting() {
    const greeting = greetingForHour(new Date().getHours())
    document.querySelectorAll('[data-home-greeting]').forEach((element) => { element.textContent = greeting })
  }
  updateGreeting()
  document.addEventListener('astro:page-load', updateGreeting)
</script>

<style>
  .hero-feature { position: relative; isolation: isolate; overflow: hidden; min-height: 360px; display: flex; align-items: center; background: var(--color-art-surface); }
  .hero-artwork { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, var(--color-bg-alt) 0%, color-mix(in srgb, var(--color-bg-alt) 94%, transparent) 30%, color-mix(in srgb, var(--color-bg-alt) 65%, transparent) 48%, transparent 75%); }
  .hero-content { padding: 2.5rem 3rem; max-width: 64%; }
  .hero-eyebrow { display: flex; flex-wrap: wrap; gap: 0.65rem; color: var(--color-text-muted); font-size: 0.75rem; letter-spacing: 0.12em; }
  .hero-dot { color: var(--color-accent); }
  #hero-title { margin: 0.8rem 0; font-size: clamp(2.4rem, 4.5vw, 3.7rem); letter-spacing: 0.08em; }
  .hero-subtitle { color: var(--color-text-muted); font-family: var(--font-heading); font-size: 1rem; line-height: 1.9; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-4) var(--space-6); margin-top: var(--space-6); }
  .hero-actions :global(.text-link) { color: var(--color-text); font-size: 0.85rem; min-height: 2.75rem; }
  .hero-actions :global(.text-link:hover) { color: var(--color-accent); }
  .hero-inscription { position: absolute; right: 2rem; top: 1.75rem; display: flex; align-items: center; flex-direction: column; gap: 1.25rem; }
  .hero-inscription > span { writing-mode: vertical-rl; font-family: var(--font-heading); font-size: 1rem; letter-spacing: 0.25em; color: var(--color-text); }
  .hero-caption { position: absolute; right: 2rem; bottom: 1.3rem; padding: 0.15rem 0.45rem; background: color-mix(in srgb, var(--color-bg) 85%, transparent); font-size: 0.65rem; letter-spacing: 0.12em; color: var(--color-text-muted); }
  @media (max-width: 767px) {
    .hero-content { padding: 2rem 3.5rem 2rem 1.25rem; max-width: 100%; }
    #hero-title { font-size: clamp(2rem, 9vw, 2.4rem); }
    .hero-inscription { right: 1rem; }
    .hero-overlay { background: color-mix(in srgb, var(--color-bg-alt) 82%, transparent); }
    .hero-caption { display: none; }
  }
</style>
