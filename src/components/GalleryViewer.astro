<dialog class="gallery-viewer" id="gallery-viewer" aria-labelledby="gallery-viewer-title" aria-describedby="gallery-viewer-help">
  <header class="viewer-header">
    <h3 id="gallery-viewer-title">画间四时 <span>· 展卷</span></h3>
    <p id="gallery-viewer-help">← → 切换 · Esc 关闭</p>
    <button class="viewer-control viewer-close" type="button" data-gallery-close autofocus aria-label="关闭大图">关闭 <span aria-hidden="true">×</span></button>
  </header>
  <div class="viewer-stage" data-gallery-stage aria-busy="false">
    <!-- The selected source is assigned on open, preserving thumbnail lazy loading. -->
    <img class="viewer-image" data-gallery-image alt="" decoding="async" />
    <p class="viewer-notice" data-gallery-loading role="status" hidden>正在展卷…</p>
    <p class="viewer-notice" data-gallery-error role="status" hidden>画作暂时无法加载，请切换画作后重试。</p>
  </div>
  <footer class="viewer-footer">
    <button class="viewer-control" type="button" data-gallery-previous aria-label="上一幅画作"><span aria-hidden="true">←</span><span class="control-label">上一幅</span></button>
    <p class="viewer-caption" aria-live="polite" aria-atomic="true"><span class="viewer-artwork-title" data-gallery-title></span><span class="viewer-count" data-gallery-count></span></p>
    <button class="viewer-control" type="button" data-gallery-next aria-label="下一幅画作"><span class="control-label">下一幅</span><span aria-hidden="true">→</span></button>
  </footer>
</dialog>

<script>
  import '../scripts/gallery'
</script>

<style>
  .gallery-viewer { position: fixed; inset: 0; width: min(76rem, calc(100% - 3rem)); max-width: none; max-height: calc(100dvh - 3rem); margin: auto; padding: 0; border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-text); box-shadow: 0 1.5rem 5rem #0005; }
  .gallery-viewer[open] { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; }
  .gallery-viewer::backdrop { background: rgb(15 17 14 / 82%); }
  .viewer-header { display: flex; align-items: center; gap: var(--space-6); padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--color-border); }
  h3 { font-size: 1rem; }
  h3 span { color: var(--color-text-muted); font-size: 0.8rem; }
  #gallery-viewer-help { margin-left: auto; color: var(--color-text-muted); font-size: 0.7rem; }
  .viewer-control { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-3); flex: none; min-width: 44px; min-height: 44px; padding: var(--space-2) var(--space-3); border: 1px solid var(--color-border); background: transparent; color: var(--color-text); cursor: pointer; font-size: 0.75rem; }
  .viewer-control:hover { border-color: var(--color-accent); color: var(--color-accent); background: var(--color-bg); }
  .viewer-control:focus-visible { outline-offset: 2px; }
  .viewer-close { border-color: transparent; }
  .viewer-close span { font-size: 1.25rem; line-height: 1; }
  .viewer-stage { position: relative; min-height: 0; height: min(68dvh, 48rem); padding: var(--space-5); background: var(--color-bg-alt); }
  .viewer-image { width: 100%; height: 100%; object-fit: contain; }
  .viewer-stage[aria-busy="true"] .viewer-image, .viewer-stage[data-error] .viewer-image { visibility: hidden; }
  .viewer-notice { position: absolute; top: 50%; left: 50%; width: min(28rem, 85%); transform: translate(-50%, -50%); text-align: center; color: var(--color-text-muted); font-size: 0.85rem; }
  .viewer-footer { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-5); padding: var(--space-3) var(--space-5); border-top: 1px solid var(--color-border); }
  .viewer-caption { min-width: 0; text-align: center; }
  .viewer-artwork-title { display: block; font-family: var(--font-heading); font-size: 0.95rem; overflow-wrap: anywhere; }
  .viewer-count { display: block; color: var(--color-text-muted); font-size: 0.7rem; font-variant-numeric: tabular-nums; }
  @media (max-width: 639px) {
    .gallery-viewer { width: calc(100% - 1rem); max-height: calc(100dvh - 1rem); }
    .viewer-header, .viewer-footer { padding: var(--space-2) var(--space-3); gap: var(--space-3); }
    .viewer-close { margin-left: auto; }
    #gallery-viewer-help { display: none; }
    .viewer-stage { height: 64dvh; padding: var(--space-3); }
    .viewer-artwork-title { font-size: 0.8rem; }
    .control-label { display: none; }
  }
  @media (max-height: 480px) {
    .gallery-viewer { max-height: calc(100dvh - 1rem); }
    .viewer-header, .viewer-footer { padding-block: var(--space-1); }
    .viewer-stage { height: 50dvh; padding: var(--space-2); }
  }
</style>
