---
import HomeInfoIcon from './HomeInfoIcon.astro'
import SectionHeading from './SectionHeading.astro'
import type { InfoItem } from '../data/home-info'

interface Props {
  label: string
  title: string
  items: InfoItem[]
}

const { label, title, items } = Astro.props
---

<section class="info-section defer-offscreen">
  <div>
    <SectionHeading label={label} title={title} />
    <div class="info-grid">
      {items.map((item) => (
        <div class="info-card">
          <div class="info-card-icon">
            <HomeInfoIcon icon={item.icon} />
          </div>
          <div>
            <div class="info-card-title">{item.name}</div>
            <div class="info-card-desc">{item.description}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .info-section {
    padding: 0;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .info-card { display: flex; align-items: start; gap: var(--space-4); min-width: 0; padding: var(--space-5); border: 1px solid var(--color-border); background: var(--color-surface); }
  .info-card-icon { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; color: var(--color-accent); background: var(--color-bg-alt); }
  .info-card-title { font-family: var(--font-heading); font-size: 1.05rem; line-height: 1.5; margin-bottom: var(--space-2); }
  .info-card-desc { color: var(--color-text-muted); font-size: 0.8rem; line-height: 1.8; overflow-wrap: anywhere; }

  @media (min-width: 640px) {
    .info-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .info-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
