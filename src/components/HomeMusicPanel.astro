---
import { homeMusicAppleLinks } from '../data/home-music';
import { loadMusicCards } from '../lib/music-cache';
import HomeMusicSwitcherScript from './HomeMusicSwitcherScript.astro';
import SectionHeading from './SectionHeading.astro';
import '../styles/music.css';

const musicCards = await loadMusicCards(homeMusicAppleLinks);
---

<section class="home-music-panel section-block" aria-labelledby="music-title">
  <div class="home-music-head">
    <SectionHeading label="四 · 听" title="案头听音" id="music-title" />
    <p class="home-music-description">书画之外，也听当下。<br />几支常听的曲子，伴一段案头时光。</p>
  </div>

  {
    musicCards.length > 0 ? (
      <div class="home-music-layout" data-home-music style={`--music-accent: ${musicCards[0].accent};`}>
        <div class="home-music-list-shell">
          <ul class="home-music-list" aria-label="案头听音曲目">
            {musicCards.map((item, index) => {
              const isActive = index === 0;
              const hasPreview = Boolean(item.previewUrl);
              const artwork = item.artwork?.replace(/\d+x\d+bb/g, '180x180bb');
              const artworkSrcSet = artwork && item.artworkSrcSet ? `${artwork} 180w, ${item.artworkSrcSet}` : undefined;
              return (
                <li>
                  <div
                    class:list={['home-music-list-item', isActive && 'is-active']}
                    data-music-item
                    data-link={item.link}
                    data-title={item.title}
                    data-artist={item.artist}
                    data-year={item.year}
                    data-genre={item.genre}
                    data-release-type={item.releaseType}
                    data-preview-url={item.previewUrl ?? ''}
                    data-track-number={item.trackNumber !== null ? String(item.trackNumber) : ''}
                    data-track-count={item.trackCount !== null ? String(item.trackCount) : ''}
                    data-accent={item.accent}
                  >
                    <button type="button" class="home-music-select" data-music-select aria-pressed={isActive ? 'true' : 'false'} aria-label={`选择曲目：${item.title}`}>
                    <span class="home-music-item-artwork" data-music-item-artwork>
                      <span class="home-music-item-artwork-cover">
                        {item.artwork ? (
                          <img
                            class="home-music-item-artwork-img"
                            src={isActive ? artwork : undefined}
                            srcset={isActive ? artworkSrcSet : undefined}
                            sizes="(max-width: 639px) 96px, 180px"
                            data-src={isActive ? undefined : artwork}
                            data-srcset={isActive ? undefined : artworkSrcSet}
                            alt={`${item.title} 封面`}
                            loading="lazy"
                            width="180"
                            height="180"
                            decoding="async"
                            crossorigin="anonymous"
                            referrerpolicy="no-referrer"
                          />
                        ) : (
                          <span class="home-music-item-artwork-fallback" aria-hidden="true">AM</span>
                        )}
                      </span>
                    </span>

                    <span class="home-music-item-info">
                      <span class="home-music-list-title">{item.title}</span>
                      <span class="home-music-list-artist">{item.artist}</span>
                      <span class="home-music-item-meta">
                        <span class="home-music-item-meta-chip">{item.year}</span>
                        <span class="home-music-item-meta-chip">{item.genre}</span>
                        {!hasPreview && <span class="home-music-item-meta-chip">暂无试听</span>}
                      </span>
                    </span>
                    </button>

                    <button
                      type="button"
                      class="home-music-item-play"
                      data-music-play-toggle
                      aria-label={hasPreview ? `播放 ${item.title} 的试听片段` : '当前曲目暂无试听'}
                      aria-pressed="false"
                      disabled={!hasPreview}
                    >
                      <svg class="home-music-item-play-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path class="home-music-play-path" d="M8 5.5v13l10-6.5z" fill="currentColor" />
                        <g class="home-music-pause-path">
                          <rect x="6.5" y="5" width="3.5" height="14" rx="0.8" fill="currentColor" />
                          <rect x="14" y="5" width="3.5" height="14" rx="0.8" fill="currentColor" />
                        </g>
                      </svg>
                    </button>
                  </div>
                </li>
              );
            })}
          </ul>
          <div class="home-music-list-progress" aria-hidden="true">
            <span class="home-music-list-progress-bar"></span>
          </div>
        </div>
        <div class="home-music-footer">
          <p class="home-music-status" data-music-status role="status" aria-live="polite" aria-atomic="true">{musicCards[0].previewUrl ? `已选择《${musicCards[0].title}》，可播放试听片段。` : `《${musicCards[0].title}》暂无试听，可前往 Apple Music 听原曲。`}</p>
          <a class="home-music-original text-link" data-music-original href={musicCards[0].link} target="_blank" rel="noopener noreferrer" aria-label={`在 Apple Music 打开 ${musicCards[0].title}（新窗口）`}>在 Apple Music 听原曲 <span aria-hidden="true">↗</span></a>
          <p class="home-music-keyboard-help">方向键选曲 · Enter / 空格选择 · Tab 切换操作</p>
        </div>
      </div>
    ) : (
      <p class="home-music-empty">案头尚静，曲目稍后奉上。</p>
    )
  }
</section>

{musicCards.length > 0 && <HomeMusicSwitcherScript />}

<style>
  .home-music-panel { overflow: visible; }
  .home-music-description { color: var(--color-text-muted); font-family: var(--font-heading); font-size: 0.85rem; line-height: 1.9; }
  .home-music-list { max-height: 430px; }
  .home-music-list-artist, .home-music-list-item.is-active .home-music-list-artist, .home-music-item-meta-chip { color: var(--color-text-muted); }
  .home-music-item-play:focus-visible { opacity: 1; pointer-events: auto; }
  @media (min-width: 1024px) {
    .home-music-panel { display: grid; grid-template-columns: var(--sidebar-width) minmax(0, 1fr); gap: var(--layout-gap); }
  }
</style>
