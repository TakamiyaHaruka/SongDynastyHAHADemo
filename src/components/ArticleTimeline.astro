---
import type { CollectionEntry } from 'astro:content'
import { withBase } from '../utils/paths'
import SectionHeading from './SectionHeading.astro'
import ActionLink from './ActionLink.astro'
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props
const recentPosts = posts.slice(0, 5)
---

<section class="timeline-section" aria-labelledby="timeline-title">
  <SectionHeading label="二 · 文" title="御笔手札" id="timeline-title">
    <ActionLink slot="actions" variant="text" href={withBase('/posts/')}>文章总目 <span aria-hidden="true">↗</span></ActionLink>
  </SectionHeading>
  <div class="timeline-list">
    {recentPosts.map((post) => (
      <a href={withBase(`/posts/${post.id}/`)} class="timeline-item">
        <time class="timeline-date" datetime={post.data.date}><span class="timeline-year">{post.data.date?.slice(0, 4)}</span><span>{post.data.date?.slice(5).replace('-', ' / ')}</span></time>
        <div class="timeline-content"><h3 class="timeline-title">{post.data.title}</h3>{post.data.description && <p class="timeline-desc">{post.data.description}</p>}</div>
        {post.data.category && <span class="timeline-category">{post.data.category}</span>}
        <span class="timeline-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>

<style>
  .timeline-section { min-width: 0; }
  .timeline-list { display: flex; flex-direction: column; }
  .timeline-item { display: flex; align-items: center; gap: var(--space-6); padding: var(--space-5) 0; border-bottom: 1px solid var(--color-border); color: var(--color-text); }
  .timeline-item:first-child { border-top: 1px solid var(--color-border); }
  .timeline-date { display: flex; flex-direction: column; flex-shrink: 0; width: 4rem; color: var(--color-text-muted); font-size: 0.7rem; font-variant-numeric: tabular-nums; }
  .timeline-year { color: var(--color-text); font-family: var(--font-heading); font-size: 1rem; }
  .timeline-content { flex: 1; min-width: 0; }
  .timeline-title { margin-bottom: 0.35rem; font-size: 1.15rem; transition: color 0.2s ease; }
  .timeline-desc { font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.65; }
  .timeline-category { color: var(--color-text-muted); font-size: 0.7rem; flex-shrink: 0; }
  .timeline-arrow { color: var(--color-text-muted); transition: transform 0.2s ease, color 0.2s ease; }
  .timeline-item:hover .timeline-title, .timeline-item:hover .timeline-arrow { color: var(--color-accent); }
  .timeline-item:hover .timeline-arrow { transform: translate(2px, -2px); }
  @media (max-width: 640px) {
    .timeline-item { gap: 0.8rem; }
    .timeline-category, .timeline-arrow { display: none; }
  }
</style>
