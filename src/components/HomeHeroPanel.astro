---
import NameSeal from './NameSeal.astro'
import { socialLinks } from '../data/social-links'
import { withBase } from '../utils/paths'
const heroSocials = socialLinks.filter((link) => link.heroOrder <= 5).sort((a, b) => a.heroOrder - b.heroOrder)
---

<div class="hero-panel">
  <div class="hero-panel-heading"><NameSeal /><div><h2>赵佶</h2><p>宋徽宗 · 艺术家皇帝</p></div></div>
  <p class="hero-panel-intro">一卷丹青，一盏清茶。<br />艺术人生，留与后人评说。</p>
  <div class="hero-panel-study"><p class="section-label">艺事与文房</p><p>瘦金体 · 工笔花鸟 · 园林<br />端砚 · 宣和笔 · 澄心堂纸</p><a class="text-link" href={withBase('/about/#study')}>走进书房 <span aria-hidden="true">↗</span></a></div>
  <div class="hero-panel-socials">{heroSocials.map((link) => <a href={link.url} target={link.url.startsWith('http') ? '_blank' : undefined} rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}>{link.name} <span aria-hidden="true">↗</span></a>)}<a href={withBase('/rss/')}>RSS <span aria-hidden="true">↗</span></a></div>
</div>

<style>
  .hero-panel { padding-top: 0.2rem; position: sticky; top: 96px; }
  .hero-panel-heading { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.4rem; }
  .hero-panel-heading h2 { font-size: 1.6rem; margin-bottom: 0.25rem; }
  .hero-panel-heading p { font-size: 0.7rem; color: var(--color-text-muted); }
  .hero-panel-intro { font-family: var(--font-heading); color: var(--color-text-muted); font-size: 0.85rem; line-height: 2; }
  .hero-panel-study { border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); margin: 1.5rem 0; padding: 1.35rem 0; }
  .hero-panel-study > p:not(.section-label) { font-size: 0.8rem; color: var(--color-text-muted); line-height: 2; margin-bottom: 1rem; }
  .hero-panel-socials { display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: 0.7rem; }
  .hero-panel-socials a { color: var(--color-text-muted); }
  .hero-panel-socials a:hover { color: var(--color-accent); }
</style>
