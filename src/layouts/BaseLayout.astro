---
import '../styles/global.css'
import '../../.cache/site-fonts/index.css'
import { ClientRouter } from 'astro:transitions'
import { socialLinks } from '../data/social-links'
import { getRoutePath, withBase } from '../utils/paths'
import { serializeJsonLd } from '../utils/structured-data'
import ThemePicker from '../components/ThemePicker.astro'

interface Props {
  title: string
  description?: string
  ogImage?: string
  currentPath?: string
  article?: { publishedAt: string; updatedAt?: string }
}

const base = withBase('/')

const {
  title,
  description = '宋代主题手札，记书画、茶事与园林，也留几页日常。',
  ogImage,
  currentPath = Astro.url.pathname,
  article,
} = Astro.props

const siteUrl = new URL(base, Astro.site).toString()
const fullTitle = `${title} - 宋徽宗`
const routePath = getRoutePath(currentPath)
const canonicalUrl = new URL(withBase(routePath === '/' ? '/' : routePath === '/404' ? '/404.html' : `${routePath}/`), siteUrl).toString()
const pageImages: Record<string, string> = { '/': 'index', '/posts': 'posts', '/about': 'about', '/friends': 'friends', '/404': '404' }
const defaultOgPath = routePath.startsWith('/posts/category/')
  ? `og/category/${routePath.slice('/posts/category/'.length)}.png`
  : `og/page/${pageImages[routePath] ?? 'index'}.png`
const ogImageUrl = ogImage ?? new URL(`${base}${defaultOgPath}`, siteUrl).toString()
const githubLink = socialLinks.find((link) => link.name === 'GitHub')

const navItems = [
  { label: '首页', href: base },
  { label: '文章', href: `${base}posts/` },
  { label: '友人', href: `${base}friends/` },
  { label: '关于', href: `${base}about/` },
]

function isActive(href: string): boolean {
  const targetPath = getRoutePath(href)
  if (targetPath === '/') return routePath === '/'
  return routePath === targetPath || routePath.startsWith(`${targetPath}/`)
}
---

<!doctype html>
<html lang="zh-cn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf7f2" />
    <script is:inline src={withBase('/js/theme-init.js')} data-astro-rerun></script>
    <ClientRouter fallback="swap" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {routePath === '/404' && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={`${article.publishedAt}T00:00:00Z`} />}
    {article && <meta property="article:modified_time" content={`${article.updatedAt ?? article.publishedAt}T00:00:00Z`} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="宋徽宗" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <slot name="head" />

    <!-- Sitemap -->
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="宋徽宗 RSS" href={`${base}rss.xml`} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={serializeJsonLd({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: '宋徽宗',
      url: siteUrl,
      description,
    })} />
    {article && <script type="application/ld+json" set:html={serializeJsonLd({
      '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title,
      description, image: [ogImageUrl], mainEntityOfPage: canonicalUrl,
      datePublished: article.publishedAt, dateModified: article.updatedAt ?? article.publishedAt,
      author: { '@type': 'Person', name: '宋徽宗', url: new URL(`${base}about/`, siteUrl).toString() },
    })} />}
  </head>
  <body>
    <div id="nav-sentinel" aria-hidden="true" style="position: absolute; top: 0; width: 1px; height: 1px; pointer-events: none;"></div>
    <a class="skip-link" href="#main-content">跳转到正文</a>
    <!-- Navigation -->
    <nav class="nav-bar" id="nav-bar">
      <div class="nav-inner">
        <a href={base} class="nav-brand">
          <span class="nav-brand-name">大宋王朝</span>
        </a>

        <div class="nav-actions">
        <!-- Desktop Links -->
        <ul class="nav-links">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href={`${base}rss/`} class:list={['nav-link', { 'is-active': routePath === '/rss' }]} aria-label="RSS 订阅" aria-current={routePath === '/rss' ? 'page' : undefined}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.18 15.64a2.18 2.18 0 010 4.36 2.18 2.18 0 010-4.64zM4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44zm0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z" />
              </svg>
            </a>
          </li>
        </ul>
        <ThemePicker />

        <!-- Mobile Hamburger -->
        <button
          class="nav-hamburger"
          id="nav-hamburger"
          aria-label="打开菜单"
          aria-expanded="false"
          aria-controls="drawer-panel"
        >
          <span class="nav-hamburger-line"></span>
          <span class="nav-hamburger-line"></span>
          <span class="nav-hamburger-line"></span>
        </button>
        </div>
      </div>
    </nav>

    <!-- Mobile Drawer -->
    <div class="drawer-backdrop" id="drawer-backdrop"></div>
    <aside class="drawer-panel" id="drawer-panel" role="dialog" aria-modal="true" aria-label="站点导航" aria-hidden="true" inert>
      <button class="drawer-close" id="drawer-close" aria-label="关闭菜单">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>

      <!-- Profile Card -->
      <div class="drawer-profile">
        <div class="drawer-profile-name">宋徽宗</div>
        <div class="drawer-profile-description">大宋天子 · 艺术人生</div>
      </div>

      <!-- Nav Links -->
      <div class="drawer-links">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-link drawer-link',
              { 'is-active': isActive(item.href) },
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Social Links -->
      <div class="drawer-socials">
        {[...socialLinks]
          .sort((a, b) => a.drawerOrder - b.drawerOrder)
          .map((link) => (
            <a
              href={link.url}
              target={link.url.startsWith('http') ? '_blank' : undefined}
              rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={link.name}
              class="drawer-social-link"
            >
              <svg width="18" height="18" viewBox={link.viewBox} fill="currentColor">
                <path d={link.icon} />
              </svg>
            </a>
          ))}
      </div>
    </aside>

    <!-- Spacer -->
    <div class="nav-spacer"></div>

    <!-- Main Content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-inner">
        <span>&copy; {new Date().getFullYear()} 宋徽宗 赵佶. All rights reserved.</span>
        <ul class="footer-links">
          <li><a href={`${base}rss/`}>RSS</a></li>
          {githubLink && <li><a href={githubLink.url} target="_blank" rel="noopener noreferrer">GitHub</a></li>}
        </ul>
      </div>
    </footer>

    <!-- Client Scripts -->
    <script>
      import '../scripts/navigation'
    </script>
  </body>
</html>
