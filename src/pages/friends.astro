---
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionHeading from '../components/SectionHeading.astro'
import FriendCard from '../components/FriendCard.astro'
import { friends, voidFriends } from '../data/friends'

const allFriends = friends
const dormantFriends = voidFriends
---

<BaseLayout title="友人" currentPath="/friends">
  <div class="container-main page-shell">
    <SectionHeading label="友情链接" title="友人帐" level="h1" variant="page" description="感谢每一位朋友的链接与陪伴。" />

    <!-- Active Friends -->
    <section aria-labelledby="friends-active-title">
      <SectionHeading title="常来常往" id="friends-active-title" variant="compact" />
      <div class="friends-grid">{allFriends.map(friend => <FriendCard friend={friend} />)}</div>
    </section>

    {/* Dormant Friends */}
    {dormantFriends.length > 0 && (
      <section class="friends-dormant" aria-labelledby="friends-dormant-title">
        <SectionHeading title="休眠中的友人" id="friends-dormant-title" variant="compact" />
        <div class="friends-grid">{dormantFriends.map(friend => <FriendCard friend={friend} />)}</div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .friends-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .friends-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .friends-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .friends-dormant { margin-top: var(--section-space); }
</style>
