---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCollection from '../../components/PostCollection.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import { getPublishedPosts } from '../../lib/posts'
import { getCategoryItems } from '../../utils/categories'

const posts = await getPublishedPosts()
const categories = getCategoryItems(posts)
---

<BaseLayout title="文章" currentPath="/posts">
  <div class="container-main page-shell">
    <SectionHeading label="御笔手札" title="文章总目" level="h1" variant="page">
      <span slot="actions">共 {posts.length} 篇手札</span>
    </SectionHeading>
    <PostCollection posts={posts} categories={categories} />
  </div>
</BaseLayout>
