---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import PostCollection from '../../../../../components/PostCollection.astro'
import SectionHeading from '../../../../../components/SectionHeading.astro'
import { getPublishedPosts } from '../../../../../lib/posts'
import { getCategoryItems } from '../../../../../utils/categories'
import { getTagItems, listPage, pagePath } from '../../../../../utils/post-lists'
export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  const tags = getTagItems(posts)
  return tags.flatMap(tag => {
    const filtered = posts.filter(post => post.data.tags?.includes(tag.name))
    const basePath = `/posts/tag/${encodeURIComponent(tag.name)}`
    return Array.from({ length: listPage(filtered, basePath).pagination.totalPages - 1 }, (_, index) => ({
      params: { tag: tag.name, page: String(index + 2) },
      props: { tag: tag.name, ...listPage(filtered, basePath, index + 2), categories: getCategoryItems(posts), tags },
    }))
  })
}
const { tag, posts, pagination, categories, tags } = Astro.props
---
<BaseLayout title={`标签: ${tag} · 第 ${pagination.currentPage} 页`} currentPath={pagePath(pagination.basePath, pagination.currentPage)}>
  <div class="container-main page-shell">
    <SectionHeading label="标签手札" title={tag} level="h1" variant="page"><span slot="actions">共 {pagination.totalPosts} 篇手札</span></SectionHeading>
    <PostCollection posts={posts} pagination={pagination} categories={categories} tags={tags} activeTag={tag} />
  </div>
</BaseLayout>
