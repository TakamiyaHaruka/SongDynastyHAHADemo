---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import PostCollection from '../../../../../components/PostCollection.astro'
import SectionHeading from '../../../../../components/SectionHeading.astro'
import { getPublishedPosts } from '../../../../../lib/posts'
import { getCategoryItems } from '../../../../../utils/categories'
import { getTagItems, listPage, pagePath } from '../../../../../utils/post-lists'
export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  const categories = getCategoryItems(posts)
  return categories.flatMap(category => {
    const filtered = posts.filter(post => (post.data.category ?? 'Uncategorized') === category.name)
    const basePath = `/posts/category/${encodeURIComponent(category.name)}`
    return Array.from({ length: listPage(filtered, basePath).pagination.totalPages - 1 }, (_, index) => ({
      params: { category: category.name, page: String(index + 2) },
      props: { category: category.name, ...listPage(filtered, basePath, index + 2), categories, tags: getTagItems(posts) },
    }))
  })
}
const { category, posts, pagination, categories, tags } = Astro.props
---
<BaseLayout title={`分类: ${category} · 第 ${pagination.currentPage} 页`} currentPath={pagePath(pagination.basePath, pagination.currentPage)}>
  <div class="container-main page-shell">
    <SectionHeading label="分类手札" title={category} level="h1" variant="page"><span slot="actions">共 {pagination.totalPosts} 篇手札</span></SectionHeading>
    <PostCollection posts={posts} pagination={pagination} categories={categories} tags={tags} activeCategory={category} />
  </div>
</BaseLayout>
