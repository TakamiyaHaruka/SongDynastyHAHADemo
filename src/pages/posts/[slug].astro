---
import '../../styles/prose.css'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ArticleToc from '../../components/ArticleToc.astro'
import { render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '../../utils/date'
import { getPublishedPosts } from '../../lib/posts'
import { withBase } from '../../utils/paths'
import { getAdjacentPosts } from '../../utils/post-navigation.js'

interface PostLink { id: string; title: string }
interface Props { entry: CollectionEntry<'blog'>; previousPost?: PostLink; nextPost?: PostLink }

export async function getStaticPaths() {
  const sorted = await getPublishedPosts()
  return sorted.map((post) => {
    const { previous, next } = getAdjacentPosts(sorted, post.id)
    return {
      params: { slug: post.id },
      props: {
        entry: post,
        previousPost: previous ? { id: previous.id, title: previous.data.title } : undefined,
        nextPost: next ? { id: next.id, title: next.data.title } : undefined,
      },
    }
  })
}

const { entry, previousPost, nextPost } = Astro.props
const { title, description, date, category, tags, publishedAt, updatedAt } = entry.data
const { Content, headings } = await render(entry)
const duplicateTitle = headings[0]?.depth === 2 && headings[0]?.text === title
const tocHeadings = headings.filter((heading, index) => heading.depth >= 2 && heading.depth <= 3 && !(duplicateTitle && index === 0))
const ogImageUrl = new URL(withBase(`/og/${entry.id}.png`), Astro.site).toString()
---

<BaseLayout title={title} description={description} ogImage={ogImageUrl} currentPath={`/posts/${entry.id}`} article={{ publishedAt: publishedAt!, updatedAt }}>
  <div class="reading-shell container-main">
    <a class="reading-back text-link" href={withBase('/posts/')}><span aria-hidden="true">←</span>文章总目</a>
    <div class:list={['reading-layout', { 'has-toc': tocHeadings.length > 0 }]}>
      <article class="reading-article">
        <header class="post-header">
          <p class="section-label">御笔手札</p>
          <h1 class="post-title">{title}</h1>
          {description && <p class="post-description">{description}</p>}
          <div class="post-meta">
            {category && <a class="tag" href={withBase(`/posts/category/${encodeURIComponent(category)}/`)}>{category}</a>}
            {date && <time datetime={date}>{formatDate(date)}</time>}
          </div>
          <p class="post-site-date">本站收录于 <time datetime={publishedAt}>{publishedAt}</time>{updatedAt && updatedAt !== publishedAt && <> · 更新于 <time datetime={updatedAt}>{updatedAt}</time></>}</p>
          {tags && tags.length > 0 && <ul class="post-tags" aria-label="文章标签">{tags.map((tag) => <li>{tag}</li>)}</ul>}
        </header>
        <div class:list={['prose', 'article-prose', { 'has-duplicate-title': duplicateTitle }]}><Content /></div>
        {(previousPost || nextPost) && (
          <nav class="post-navigation" aria-label="相邻文章">
            {previousPost && <a class="post-nav-link" href={withBase(`/posts/${previousPost.id}/`)} rel="prev"><span class="post-nav-label">← 上一篇</span><span class="post-nav-title">{previousPost.title}</span></a>}
            {nextPost && <a class="post-nav-link post-nav-next" href={withBase(`/posts/${nextPost.id}/`)} rel="next"><span class="post-nav-label">下一篇 →</span><span class="post-nav-title">{nextPost.title}</span></a>}
          </nav>
        )}
        <div class="post-footer"><a class="text-link" href={withBase('/posts/')}>返回文章总目 <span aria-hidden="true">↗</span></a></div>
      </article>
      {tocHeadings.length > 0 && <ArticleToc headings={tocHeadings} />}
    </div>
  </div>
</BaseLayout>

<style>
  .reading-shell { padding-block: var(--page-block-space); }
  .reading-back { margin-bottom: 2rem; }
  .reading-layout { max-width: 760px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  .reading-article { min-width: 0; }
  .post-header { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .post-title { font-size: var(--text-page); line-height: 1.5; margin: var(--space-3) 0; overflow-wrap: anywhere; text-wrap: balance; }
  .post-description { color: var(--color-text-muted); font-family: var(--font-heading); font-size: 1.05rem; line-height: 1.9; margin-bottom: 1.5rem; }
  .post-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem; color: var(--color-text-muted); font-size: 0.75rem; }
  .post-site-date { margin-top: var(--space-2); color: var(--color-text-muted); font-size: 0.7rem; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; list-style: none; padding: 0; margin: 1rem 0 0; color: var(--color-text-muted); font-size: 0.7rem; }
  .post-tags li::before { content: '#'; color: var(--color-border); margin-right: 0.2rem; }
  .article-prose { max-width: none; font-family: var(--font-heading); font-size: 1.05rem; }
  .has-duplicate-title :global(> h2:first-child) { display: none; }
  .article-prose :global(h3) { margin-top: 2rem; }
  .post-navigation { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; border-top: 1px solid var(--color-border); padding-top: 1.5rem; margin-top: 3rem; }
  .post-nav-link { display: flex; flex-direction: column; gap: 0.5rem; color: var(--color-text); min-width: 0; }
  .post-nav-label { color: var(--color-text-muted); font-size: 0.7rem; }
  .post-nav-title { font-family: var(--font-heading); font-size: 1.1rem; overflow-wrap: anywhere; }
  .post-nav-next { text-align: right; grid-column: 2; }
  .post-nav-link:hover { color: var(--color-accent); }
  .post-footer { margin-top: 2rem; }
  @media (min-width: 1024px) {
    .reading-layout.has-toc { max-width: none; grid-template-columns: minmax(0, 760px) minmax(180px, 1fr); gap: 4rem; }
  }
</style>
