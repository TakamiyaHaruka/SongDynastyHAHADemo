---
import BaseLayout from '../layouts/BaseLayout.astro'
import HomeHeroFeature from '../components/HomeHeroFeature.astro'
import HomeHeroPanel from '../components/HomeHeroPanel.astro'
import ArticleTimeline from '../components/ArticleTimeline.astro'
import HomeProjectPanel from '../components/HomeProjectPanel.astro'
import HomeMusicPanel from '../components/HomeMusicPanel.astro'
import HomeGalleryPanel from '../components/HomeGalleryPanel.astro'
import { getPublishedPosts } from '../lib/posts'
import { homeHeroArtwork } from '../data/home-artwork'

const posts = await getPublishedPosts()
---

<BaseLayout title="首页" currentPath="/">
  <link slot="head" rel="preload" as="image" href={homeHeroArtwork.src} fetchpriority="high" />
  <div class="home-exhibition container-main">
    <HomeHeroFeature />
    <HomeGalleryPanel />
    <div class="home-reading section-block">
      <ArticleTimeline posts={posts} />
      <aside class="home-profile" aria-label="关于赵佶"><HomeHeroPanel /></aside>
    </div>
    <HomeProjectPanel />
    <HomeMusicPanel />
  </div>
</BaseLayout>

<style>
  .home-exhibition { padding-top: var(--space-8); }
  .home-reading {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--layout-gap);
  }

  @media (min-width: 1024px) {
    .home-reading {
      grid-template-columns: minmax(0, 1fr) 250px;
    }
  }

  .home-profile {
    display: none;
  }

  @media (min-width: 1024px) {
    .home-profile {
      display: block;
    }
  }
</style>
